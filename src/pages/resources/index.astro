---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResourceCard from '../../components/ResourceCard.astro';

const resources = await getCollection('resources');
const meetings = await getCollection('meetings');

// Map each resource id -> sorted list of meeting numbers that use it.
const usedIn = new Map<string, number[]>();
for (const m of meetings) {
  for (const id of [...m.data.resources, ...m.data.revisit]) {
    const list = usedIn.get(id) ?? [];
    if (!list.includes(m.data.number)) list.push(m.data.number);
    usedIn.set(id, list);
  }
}
for (const list of usedIn.values()) list.sort((a, b) => a - b);

const categoryOrder = [
  'Culture & Foundations',
  'Essential Standards & Learning Targets',
  'Common Formative Assessment',
  'Data & Evidence',
  'Intervention & Extension',
  'Reflection & Monitoring',
  'EMS Editable Templates',
  'Optional / As Needed',
];

// The EMS editable templates map to Guide steps (their link is /guide/#step-N),
// so order that category by step (1–8).
const stepNum = (r: (typeof resources)[number]) => {
  const match = r.data.url.match(/step-(\d+)/);
  return match ? Number(match[1]) : Number.MAX_SAFE_INTEGER;
};

// Order in which each resource is first encountered walking meetings 1 → 18
// (respecting the order listed within a meeting). Used to sort every other
// category chronologically instead of alphabetically, so the page reads in the
// order teams actually use the tools. Resources not tied to a meeting sort last.
const firstSeen = new Map<string, number>();
let seenCounter = 0;
for (const m of [...meetings].sort((a, b) => a.data.number - b.data.number)) {
  for (const id of [...m.data.resources, ...m.data.revisit]) {
    if (!firstSeen.has(id)) firstSeen.set(id, seenCounter++);
  }
}
const firstUseKey = (r: (typeof resources)[number]) =>
  firstSeen.get(r.id) ?? Number.MAX_SAFE_INTEGER;

const byCategory = categoryOrder
  .map((cat) => ({
    category: cat,
    items: resources
      .filter((r) => r.data.category === cat)
      .sort((a, b) => {
        if (cat === 'EMS Editable Templates') return stepNum(a) - stepNum(b);
        const diff = firstUseKey(a) - firstUseKey(b);
        return diff !== 0 ? diff : a.data.title.localeCompare(b.data.title);
      }),
  }))
  .filter((g) => g.items.length > 0);

const requiredPacket = resources
  .filter((r) => r.data.required)
  .sort((a, b) => (usedIn.get(a.id)?.[0] ?? 99) - (usedIn.get(b.id)?.[0] ?? 99));

// Which Guide step(s) and meetings each category maps to — shown under the
// category header so the Guide ↔ Meetings ↔ Resources alignment is explicit.
const categoryMeta: Record<string, string> = {
  'Culture & Foundations': 'Guide Step 1 · Meetings 1–4',
  'Essential Standards & Learning Targets': 'Guide Steps 2–3 · Meetings 5–8',
  'Common Formative Assessment': 'Guide Step 4 · Meetings 9–12',
  'Data & Evidence': 'Guide Step 5 · Meetings 13–17',
  'Intervention & Extension': 'Guide Steps 6–7 · Meetings 15–16',
  'Reflection & Monitoring': 'Guide Steps 8–9 · Meetings 14 & 18',
  'EMS Editable Templates': 'Editable versions of the Guide’s Step 1–8 templates',
  'Optional / As Needed': 'Layer in when your team is ready',
};
---

<BaseLayout
  title="Resources"
  description="Every reproducible in the EMS PLT playbook — Solution Tree and AllThingsPLC tools plus editable EMS templates — with how and why to use each, and which meetings they support."
>
  <PageHeader
    eyebrow="Reproducibles & Tools"
    title="Resources"
    subtitle="Every tool a team needs for the year, organized so PLTs never feel like PLC is just a packet of forms. Begin with the start-here packet, then reach for the rest as needed."
  />

  <div class="mx-auto max-w-6xl px-4 py-12">
    <!-- How this page works -->
    <div class="rounded-2xl border border-brand-200 bg-brand-50 p-5 md:p-6">
      <h2 class="font-bold text-brand-800">How this page works</h2>
      <p class="mt-2 text-sm text-slate-700">
        These are the reproducibles teams fill out — the tools you actually use.
        They're grouped by stage of the
        <a href="/guide/" class="font-medium text-brand-700 underline">9-step Guide</a>
        and listed in the order you first reach them across the
        <a href="/meetings/" class="font-medium text-brand-700 underline">18 meetings</a>.
        Each card shows the meeting(s) where it's used. Begin with the start-here
        packet below; reach for the rest as needed.
      </p>
    </div>

    <!-- Sourcing note -->
    <div
      class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-900"
    >
      <p>
        <strong>About the links.</strong> Most cards link straight to the
        official free reproducible PDF on
        <a
          class="underline"
          href="https://www.solutiontree.com/free-resources"
          target="_blank"
          rel="noopener noreferrer">Solution Tree</a
        >, whose reproducibles may be copied and distributed within teams,
        schools, and districts. A few tools without a direct public link point to
        the book's resource page instead — look for the tool by name there.
        EMS-created templates are editable equivalents inspired by the PLC at
        Work process, not copies of copyrighted forms. Update any link by editing
        <code class="rounded bg-amber-100 px-1">src/data/resources.json</code>.
      </p>
    </div>

    <!-- Start-here packet -->
    <section class="mt-10">
      <h2 class="text-2xl font-bold text-brand-800">
        Start here: your first-year packet
      </h2>
      <p class="mt-2 max-w-3xl text-slate-600">
        For teams that want to be led step by step, begin with only these — the
        full cycle in one packet, in the order you use them. The tag on each shows
        the meeting where you first pick it up.
      </p>
      <ol class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          requiredPacket.map((r) => (
            <li>
              <a
                href={`#${r.id}`}
                class="flex h-full items-start gap-3 rounded-xl border border-brand-200 bg-white p-4 shadow-sm transition-colors hover:border-brand-400 hover:bg-brand-50"
              >
                <span class="shrink-0 rounded-md bg-brand-800 px-2 py-1 text-[11px] font-semibold text-white">
                  Mtg {usedIn.get(r.id)?.[0]}
                </span>
                <span>
                  <span class="block text-sm font-semibold text-brand-800">
                    {r.data.title}
                  </span>
                  <span class="text-xs text-slate-500">{r.data.source}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- All resources by category -->
    {
      byCategory.map((group) => (
        <section class="mt-14">
          <div class="border-l-4 border-accent-400 pl-4">
            <h2 class="text-xl font-bold text-brand-800">{group.category}</h2>
            {categoryMeta[group.category] && (
              <p class="mt-0.5 text-sm text-slate-500">
                {categoryMeta[group.category]}
              </p>
            )}
          </div>
          <div class="mt-5 grid gap-4 md:grid-cols-2">
            {group.items.map((r) => (
              <ResourceCard resource={r} usedIn={usedIn.get(r.id) ?? []} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
