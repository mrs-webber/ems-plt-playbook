---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResourceCard from '../../components/ResourceCard.astro';

const resources = await getCollection('resources');
const meetings = await getCollection('meetings');

// Map each resource id -> sorted list of meeting numbers that use it.
const usedIn = new Map<string, number[]>();
for (const m of meetings) {
  for (const id of [...m.data.resources, ...m.data.revisit]) {
    const list = usedIn.get(id) ?? [];
    if (!list.includes(m.data.number)) list.push(m.data.number);
    usedIn.set(id, list);
  }
}
for (const list of usedIn.values()) list.sort((a, b) => a - b);

const categoryOrder = [
  'Culture & Foundations',
  'Clarifying Essential Learning',
  'Common Formative Assessment',
  'Data & Evidence',
  'Intervention & Extension',
  'Reflection & Monitoring',
  'EMS Editable Templates',
  'Optional / As Needed',
];

// The EMS editable templates map to Guide steps (their link is /guide/#step-N),
// so order that category by step (1–8).
const stepNum = (r: (typeof resources)[number]) => {
  const match = r.data.url.match(/step-(\d+)/);
  return match ? Number(match[1]) : Number.MAX_SAFE_INTEGER;
};

// Order in which each resource is first encountered walking meetings 1 → 18
// (respecting the order listed within a meeting). Used to sort every other
// category chronologically instead of alphabetically, so the page reads in the
// order teams actually use the tools. Resources not tied to a meeting sort last.
const firstSeen = new Map<string, number>();
let seenCounter = 0;
for (const m of [...meetings].sort((a, b) => a.data.number - b.data.number)) {
  for (const id of [...m.data.resources, ...m.data.revisit]) {
    if (!firstSeen.has(id)) firstSeen.set(id, seenCounter++);
  }
}
const firstUseKey = (r: (typeof resources)[number]) =>
  firstSeen.get(r.id) ?? Number.MAX_SAFE_INTEGER;

const byCategory = categoryOrder
  .map((cat) => ({
    category: cat,
    items: resources
      .filter((r) => r.data.category === cat)
      .sort((a, b) => {
        if (cat === 'EMS Editable Templates') return stepNum(a) - stepNum(b);
        const diff = firstUseKey(a) - firstUseKey(b);
        return diff !== 0 ? diff : a.data.title.localeCompare(b.data.title);
      }),
  }))
  .filter((g) => g.items.length > 0);

// Which Guide step(s) and meetings each category maps to — shown under the
// category header so the Guide ↔ Meetings ↔ Resources alignment is explicit.
const categoryMeta: Record<string, string> = {
  'Culture & Foundations': 'Guide Step 1 · Meetings 1–4',
  'Clarifying Essential Learning': 'Guide Steps 2–3 · Meetings 5–8',
  'Common Formative Assessment': 'Guide Step 4 · Meetings 9–12',
  'Data & Evidence': 'Guide Step 5 · Meetings 13–17',
  'Intervention & Extension': 'Guide Steps 6–7 · Meetings 15–16',
  'Reflection & Monitoring': 'Guide Steps 8–9 · Meetings 14 & 18',
  'EMS Editable Templates': 'Editable versions of the Guide’s Step 1–8 templates',
  'Optional / As Needed': 'Layer in when your team is ready',
};

// Slug used for the jump-nav anchors and matching section ids.
const catId = (c: string) =>
  c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<BaseLayout
  title="Resources"
  description="Every reproducible in the EMS PLT playbook — Solution Tree and AllThingsPLC tools plus editable EMS templates — with how and why to use each, and which meetings they support."
>
  <PageHeader
    eyebrow="Reproducibles & Tools"
    title="Resources"
    subtitle="Every tool a team needs for the year, organized so PLTs never feel like PLC is just a packet of forms. Begin with the start-here packet, then reach for the rest as needed."
  />

  <div class="mx-auto max-w-6xl px-4 py-12">
    <!-- How this page works -->
    <div class="rounded-2xl border border-brand-200 bg-brand-50 p-5 md:p-6">
      <h2 class="font-bold text-brand-800">How this page works</h2>
      <p class="mt-2 text-sm text-slate-700">
        These are the reproducibles teams fill out — the tools you actually use.
        They're grouped by stage of the
        <a href="/guide/" class="font-medium text-brand-700 underline">9-step Guide</a>
        and listed in the order you first reach them across the
        <a href="/meetings/" class="font-medium text-brand-700 underline">18 meetings</a>.
        Each card shows the meeting(s) where it's used, and a label for how
        central it is:
      </p>
      <ul class="mt-3 space-y-2 text-sm text-slate-700">
        <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-2">
          <span class="w-fit shrink-0 rounded-full bg-brand-800 px-2.5 py-0.5 text-xs font-semibold text-white">
            Essential Resource
          </span>
          <span>
            The core set every team completes to move through one full PLC cycle.
            Start with these.
          </span>
        </li>
        <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-2">
          <span class="w-fit shrink-0 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600 ring-1 ring-inset ring-slate-200">
            Additional Support Resource
          </span>
          <span>
            Optional tools to reach for when your team wants extra help at a given
            step. Use as needed — you don't need all of them.
          </span>
        </li>
      </ul>
    </div>

    <!-- Roadmaps -->
    <section id="roadmaps" class="mt-8">
      <div class="border-l-4 border-accent-400 pl-4">
        <h2 class="text-xl font-bold text-brand-800">Roadmaps &amp; big-picture handouts</h2>
        <p class="mt-0.5 text-sm text-slate-500">
          Share these with teams to show where we're headed this year and beyond.
        </p>
      </div>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <article class="flex h-full flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <span class="w-fit rounded-full bg-accent-50 px-2.5 py-0.5 text-xs font-semibold text-accent-600 ring-1 ring-inset ring-accent-300">
            One page · Poster
          </span>
          <h3 class="mt-3 font-semibold text-brand-800">The Road to PLC Right — one-page poster</h3>
          <p class="mt-2 flex-1 text-sm text-slate-600">
            An at-a-glance visual: this year's 18-meeting road, the Meeting 13
            turning point, and the multi-year climb from PLC Lite to PLC Right.
            Landscape — great for a wall, a slide, or a single handout.
          </p>
          <a
            href="/roadmaps/ems-plc-roadmap-one-page.pdf"
            download
            aria-label="Download the one-page PLC roadmap poster (PDF)"
            class="mt-4 inline-flex w-fit items-center gap-1.5 rounded-lg border border-brand-700 bg-brand-700 px-3 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800"
          >
            <span aria-hidden="true">⬇</span> Download PDF
          </a>
        </article>
        <article class="flex h-full flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <span class="w-fit rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600 ring-1 ring-inset ring-slate-200">
            Two pages · Detailed
          </span>
          <h3 class="mt-3 font-semibold text-brand-800">The Road to PLC Right — full roadmap</h3>
          <p class="mt-2 flex-1 text-sm text-slate-600">
            The detailed version: our destination and the four critical questions,
            the shift we're making, this year's phase-by-phase route, and the
            Year 1 → Year 3+ horizon.
          </p>
          <a
            href="/roadmaps/ems-plc-roadmap.pdf"
            download
            aria-label="Download the full two-page PLC roadmap (PDF)"
            class="mt-4 inline-flex w-fit items-center gap-1.5 rounded-lg border border-brand-700 bg-brand-700 px-3 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800"
          >
            <span aria-hidden="true">⬇</span> Download PDF
          </a>
        </article>
      </div>
    </section>

    <!-- Jump to a stage -->
    <nav aria-label="Jump to a resource stage" class="mt-4">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
        Jump to
      </p>
      <div class="mt-2 flex flex-wrap gap-2">
        {
          byCategory.map((group) => (
            <a
              href={`#${catId(group.category)}`}
              class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-brand-700 transition-colors hover:border-brand-400 hover:bg-brand-50"
            >
              {group.category}
            </a>
          ))
        }
      </div>
    </nav>

    <!-- Sourcing note -->
    <div
      class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-900"
    >
      <p>
        <strong>About the links.</strong> Most cards link straight to the
        official free reproducible PDF on
        <a
          class="underline"
          href="https://www.solutiontree.com/free-resources"
          target="_blank"
          rel="noopener noreferrer">Solution Tree</a
        >, whose reproducibles may be copied and distributed within teams,
        schools, and districts. A few tools without a direct public link point to
        the book's resource page instead — look for the tool by name there.
        EMS-created templates are editable equivalents inspired by the PLC at
        Work process, not copies of copyrighted forms.
      </p>
    </div>

    <!-- All resources by category -->
    {
      byCategory.map((group) => (
        <section id={catId(group.category)} class="mt-14">
          <div class="border-l-4 border-accent-400 pl-4">
            <h2 class="text-xl font-bold text-brand-800">{group.category}</h2>
            {categoryMeta[group.category] && (
              <p class="mt-0.5 text-sm text-slate-500">
                {categoryMeta[group.category]}
              </p>
            )}
          </div>
          <div class="mt-5 grid gap-4 md:grid-cols-2">
            {group.items.map((r) => (
              <ResourceCard resource={r} usedIn={usedIn.get(r.id) ?? []} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
