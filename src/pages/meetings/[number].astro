---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FourQuestions from '../../components/FourQuestions.astro';
import directionsData from '../../data/directions.json';
import submissionsData from '../../data/submissions.json';
import { showAccountability } from '../../config';

export async function getStaticPaths() {
  const meetings = await getCollection('meetings');
  const sorted = meetings.sort((a, b) => a.data.number - b.data.number);
  return sorted.map((m, i) => ({
    params: { number: String(m.data.number) },
    props: {
      meeting: m,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}

const { meeting, prev, next } = Astro.props;
const { Content } = await render(meeting);
const data = meeting.data;
const directions =
  (directionsData as Record<string, { t: string; d: string }[]>)[
    String(data.number)
  ] ?? [];
const submission =
  (
    submissionsData as Record<
      string,
      { artifact: string; reflect: string; proves: string }
    >
  )[String(data.number)] ?? null;

const resources = await getCollection('resources');
const byId = new Map(resources.map((r) => [r.id, r]));
const newResources = data.resources
  .map((id) => byId.get(id))
  .filter((r) => r !== undefined);
const revisitResources = data.revisit
  .map((id) => byId.get(id))
  .filter((r) => r !== undefined);

// One list (new + revisited) so the sidebar can show each tool with a direct
// download link, how-to-use note, and a clearly-labeled details link.
const meetingResources = [
  ...newResources.map((entry) => ({ entry, revisit: false })),
  ...revisitResources.map((entry) => ({ entry, revisit: true })),
];
---

<BaseLayout title={`Meeting ${data.number}: ${data.title}`} description={data.focus}>
  <section class="bg-brand-800 text-white">
    <div class="mx-auto max-w-6xl px-4 py-10 md:py-14">
      <a
        href="/meetings/"
        class="no-print inline-flex items-center gap-1 text-sm font-medium text-brand-100 hover:text-white"
      >
        ← All 18 meetings
      </a>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span
          class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-lg font-bold ring-1 ring-white/20"
        >
          {data.number}
        </span>
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-300">
          Meeting {data.number} of 18
        </p>
        {
          data.buffer && (
            <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold ring-1 ring-white/20">
              Buffer / Reset meeting
            </span>
          )
        }
        {
          data.turningPoint && (
            <span class="rounded-full bg-accent-500 px-3 py-1 text-xs font-semibold text-white">
              The turning point
            </span>
          )
        }
      </div>
      <h1 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">
        {data.title}
      </h1>
      <p class="mt-3 max-w-3xl text-lg text-brand-100">{data.focus}</p>
    </div>
  </section>

  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 lg:grid-cols-3">
    <!-- Main column -->
    <div class="lg:col-span-2">
      {
        directions.length > 0 && (
          <div class="mb-6 rounded-xl border border-brand-200 bg-brand-50 p-5">
            <h2 class="text-xl font-bold text-brand-800">How to run this meeting</h2>
            <ol class="mt-3 space-y-2.5">
              {directions.map((step, i) => (
                <li class="flex gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-800 text-xs font-bold text-white">
                    {i + 1}
                  </span>
                  <span class="text-sm leading-relaxed text-slate-700">
                    <span class="font-semibold text-brand-800">{step.t}</span> — {step.d}
                  </span>
                </li>
              ))}
            </ol>
            <p class="mt-4 border-t border-brand-200 pt-3 text-sm text-slate-700">
              <span class="font-semibold text-accent-600">Leave with:</span> {data.product}
            </p>
          </div>
        )
      }
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl font-bold text-brand-800">Meeting plan</h2>
        <div class="no-print flex flex-wrap items-center gap-2">
          {
            data.agendaPdf && (
              <a
                href={data.agendaPdf}
                download
                class="inline-flex items-center gap-1.5 rounded-lg border border-brand-700 bg-brand-700 px-3 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800"
              >
                <span aria-hidden="true">⬇</span> Agenda (PDF)
              </a>
            )
          }
          {
            data.agendaWord && (
              <a
                href={data.agendaWord}
                download
                class="inline-flex items-center gap-1.5 rounded-lg border border-brand-800 bg-brand-800 px-3 py-1.5 text-sm font-semibold text-white transition-colors hover:bg-brand-900"
              >
                <span aria-hidden="true">⬇</span> Agenda (Word)
              </a>
            )
          }
          <button
            type="button"
            data-print-trigger
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100"
          >
            <span aria-hidden="true">🖨</span> Print this agenda
          </button>
        </div>
      </div>
      <div class="rich-text print-full rounded-xl border border-slate-200 bg-white p-6">
        <Content />
      </div>

      {
        showAccountability && submission && (
          <div class="mt-6 rounded-xl border-2 border-accent-300 bg-accent-50 p-5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-lg" aria-hidden="true">
                📤
              </span>
              <h2 class="text-lg font-bold text-brand-800">
                Submit for the record
              </h2>
              <span class="rounded-full bg-accent-500 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-white">
                Milestone
              </span>
            </div>
            <dl class="mt-3 space-y-3 text-sm">
              <div>
                <dt class="font-semibold text-brand-800">Submit</dt>
                <dd class="mt-0.5 text-slate-700">{submission.artifact}</dd>
              </div>
              <div>
                <dt class="font-semibold text-brand-800">Add a short reflection</dt>
                <dd class="mt-0.5 italic text-slate-700">“{submission.reflect}”</dd>
              </div>
            </dl>
            <p class="mt-3 border-t border-accent-300 pt-3 text-sm text-slate-600">
              Drop both in your team’s shared cycle folder.{' '}
              <a
                href="/accountability/"
                class="font-medium text-brand-700 hover:underline"
              >
                How submitting works →
              </a>
            </p>
          </div>
        )
      }

      <!-- Prev / next -->
      <nav
        class="no-print mt-8 flex flex-col gap-3 sm:flex-row sm:justify-between"
        aria-label="Meeting navigation"
      >
        {
          prev ? (
            <a
              href={`/meetings/${prev.data.number}/`}
              class="flex-1 rounded-lg border border-slate-200 bg-white p-4 text-sm hover:border-brand-300"
            >
              <span class="text-slate-500">← Previous</span>
              <span class="mt-1 block font-semibold text-brand-700">
                Meeting {prev.data.number}: {prev.data.title}
              </span>
            </a>
          ) : (
            <span class="flex-1" />
          )
        }
        {
          next ? (
            <a
              href={`/meetings/${next.data.number}/`}
              class="flex-1 rounded-lg border border-slate-200 bg-white p-4 text-right text-sm hover:border-brand-300"
            >
              <span class="text-slate-500">Next →</span>
              <span class="mt-1 block font-semibold text-brand-700">
                Meeting {next.data.number}: {next.data.title}
              </span>
            </a>
          ) : (
            <span class="flex-1" />
          )
        }
      </nav>
    </div>

    <!-- Sidebar -->
    <aside class="space-y-6">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-5">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-brand-700">
          Focus question
        </h3>
        <p class="mt-2 font-medium text-brand-900">{data.plcQuestion}</p>
      </div>

      {
        data.criticalQuestions.length > 0 && (
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
              Critical question in focus
            </h3>
            <div class="mt-3">
              <FourQuestions highlight={data.criticalQuestions} />
            </div>
          </div>
        )
      }

      <div class="rounded-xl border border-accent-300 bg-accent-50 p-5">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-accent-600">
          Product / outcome
        </h3>
        <p class="mt-2 text-sm text-slate-800">{data.product}</p>
      </div>

      {
        meetingResources.length > 0 && (
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
              Reproducibles for this meeting
            </h3>
            <ul class="mt-3 space-y-3">
              {meetingResources.map(({ entry, revisit }) => {
                const external = entry.data.url.startsWith('http');
                return (
                  <li class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                    <div class="flex flex-wrap items-center gap-1.5">
                      <span
                        class:list={[
                          'rounded px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide',
                          entry.data.required
                            ? 'bg-brand-800 text-white'
                            : 'bg-white text-slate-600 ring-1 ring-inset ring-slate-300',
                        ]}
                      >
                        {entry.data.required ? 'Essential' : 'Additional support'}
                      </span>
                      {revisit && (
                        <span class="rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-600">
                          Revisit
                        </span>
                      )}
                    </div>
                    <p class="mt-1 text-sm font-semibold text-brand-800">
                      {entry.data.title}
                    </p>
                    {(entry.data.book || entry.data.bookLocation) && (
                      <p class="mt-0.5 text-xs text-slate-500">
                        {entry.data.book}
                        {entry.data.bookLocation && ` · ${entry.data.bookLocation}`}
                      </p>
                    )}
                    <p class="mt-1.5 text-xs leading-relaxed text-slate-600">
                      {entry.data.howToUse}
                    </p>
                    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5">
                      {entry.data.pdf && (
                        <a
                          href={entry.data.pdf}
                          download
                          aria-label={`Download the ${entry.data.title} PDF`}
                          class="inline-flex items-center gap-1 rounded-md border border-brand-700 bg-brand-700 px-2.5 py-1 text-xs font-semibold text-white transition-colors hover:bg-brand-800"
                        >
                          <span aria-hidden="true">⬇</span> Download PDF
                        </a>
                      )}
                      <a
                        href={entry.data.url}
                        target={external ? '_blank' : undefined}
                        rel={external ? 'noopener noreferrer' : undefined}
                        aria-label={`${entry.data.linkLabel}: ${entry.data.title}${external ? ' (opens in a new tab)' : ''}`}
                        class="inline-flex items-center gap-1 rounded-md border border-brand-200 bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700 transition-colors hover:bg-brand-100"
                      >
                        {entry.data.linkLabel}
                        <span aria-hidden="true">{external ? '↗' : '→'}</span>
                      </a>
                      <a
                        href={`/resources/#${entry.id}`}
                        class="no-print text-xs font-medium text-slate-500 hover:text-brand-700 hover:underline"
                      >
                        Details
                      </a>
                    </div>
                  </li>
                );
              })}
            </ul>
            <a
              href="/resources/"
              class="no-print mt-4 inline-block text-sm font-medium text-brand-600 hover:underline"
            >
              Browse all resources →
            </a>
          </div>
        )
      }
    </aside>
  </div>
</BaseLayout>
